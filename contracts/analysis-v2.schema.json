{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://resume.ai/contracts/analysis-v2.schema.json",
  "title": "Resume.AI independently degrading analysis response v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "analysisId", "sourceType", "score", "ai"],
  "properties": {
    "schemaVersion": {"const": 2},
    "analysisId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "sourceType": {"enum": ["reviewed_text", "pdf"]},
    "score": {"$ref": "#/$defs/score"},
    "ai": {"$ref": "#/$defs/aiResult"}
  },
  "$defs": {
    "nonEmptyText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 600
    },
    "score": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scoreVersion", "readinessScore", "label", "components", "explanations"],
      "properties": {
        "scoreVersion": {"const": "resume-readiness-v1"},
        "readinessScore": {"type": "integer", "minimum": 0, "maximum": 100},
        "label": {"enum": ["Needs work", "Developing", "Good", "Strong"]},
        "components": {"$ref": "#/$defs/components"},
        "explanations": {
          "type": "array",
          "maxItems": 12,
          "items": {"type": "string", "minLength": 1, "maxLength": 240}
        }
      }
    },
    "components": {
      "type": "object",
      "additionalProperties": false,
      "required": ["structure", "impact", "readability", "keywords"],
      "properties": {
        "structure": {"type": "integer", "minimum": 0, "maximum": 30},
        "impact": {"type": "integer", "minimum": 0, "maximum": 40},
        "readability": {"type": "integer", "minimum": 0, "maximum": 30},
        "keywords": {"type": ["integer", "null"], "minimum": 0, "maximum": 25}
      },
      "allOf": [
        {
          "if": {
            "properties": {"keywords": {"type": "null"}},
            "required": ["keywords"]
          },
          "then": {
            "properties": {
              "structure": {"maximum": 30},
              "impact": {"maximum": 40},
              "readability": {"maximum": 30},
              "keywords": {"type": "null"}
            }
          },
          "else": {
            "properties": {
              "structure": {"maximum": 25},
              "impact": {"maximum": 30},
              "readability": {"maximum": 20},
              "keywords": {"type": "integer", "minimum": 0, "maximum": 25}
            }
          }
        }
      ]
    },
    "feedback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "matchedKeywords",
        "missingKeywords",
        "strengths",
        "improvements",
        "powerBullets",
        "summary",
        "simulatedRecruiterComment"
      ],
      "properties": {
        "matchedKeywords": {
          "type": "array",
          "maxItems": 20,
          "items": {"$ref": "#/$defs/nonEmptyText"}
        },
        "missingKeywords": {
          "type": "array",
          "maxItems": 20,
          "items": {"$ref": "#/$defs/nonEmptyText"}
        },
        "strengths": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {"$ref": "#/$defs/nonEmptyText"}
        },
        "improvements": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {"$ref": "#/$defs/nonEmptyText"}
        },
        "powerBullets": {
          "type": "array",
          "maxItems": 10,
          "items": {"$ref": "#/$defs/nonEmptyText"}
        },
        "summary": {"type": "string", "minLength": 1, "maxLength": 500},
        "simulatedRecruiterComment": {
          "type": "string",
          "minLength": 1,
          "maxLength": 800,
          "pattern": "^Simulated AI recruiter feedback:"
        }
      }
    },
    "allowance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["used", "limit", "resetsAt"],
      "properties": {
        "used": {"type": "integer", "minimum": 0, "maximum": 100},
        "limit": {"enum": [3, 100]},
        "resetsAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"limit": {"const": 3}},
            "required": ["limit"]
          },
          "then": {"properties": {"used": {"maximum": 3}}}
        }
      ]
    },
    "aiResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "feedback", "allowance"],
      "properties": {
        "status": {
          "enum": [
            "complete",
            "not_requested",
            "quota_exhausted",
            "plan_verification_unavailable",
            "temporarily_unavailable",
            "timeout",
            "invalid_provider_response"
          ]
        },
        "feedback": {
          "anyOf": [
            {"$ref": "#/$defs/feedback"},
            {"type": "null"}
          ]
        },
        "allowance": {
          "anyOf": [
            {"$ref": "#/$defs/allowance"},
            {"type": "null"}
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"status": {"const": "complete"}},
            "required": ["status"]
          },
          "then": {
            "properties": {
              "feedback": {"$ref": "#/$defs/feedback"},
              "allowance": {"$ref": "#/$defs/allowance"}
            }
          },
          "else": {
            "properties": {
              "status": {
                "enum": [
                  "not_requested",
                  "quota_exhausted",
                  "plan_verification_unavailable",
                  "temporarily_unavailable",
                  "timeout",
                  "invalid_provider_response"
                ]
              },
              "feedback": {"type": "null"},
              "allowance": {
                "anyOf": [
                  {"$ref": "#/$defs/allowance"},
                  {"type": "null"}
                ]
              }
            }
          }
        }
      ]
    }
  }
}
