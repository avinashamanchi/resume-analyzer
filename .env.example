# Development-only example. Copy locally and keep the copy untracked.
APP_ENV=development
DEBUG=false
GROQ_API_KEY=replace-with-a-noncommitted-provider-key
GROQ_MODEL=llama-3.3-70b-versatile
INSTALLATION_SIGNING_KEY=replace-with-at-least-32-random-bytes
REDIS_URL=redis://localhost:6379/0
ALLOWED_WEB_ORIGINS=http://localhost:8081
PROVIDER_DEADLINE_SECONDS=8
REQUEST_DEADLINE_SECONDS=10
REVENUECAT_SECRET_API_KEY=replace-with-revenuecat-sk-server-key
REVENUECAT_APP_ID=replace-with-revenuecat-app-id
REVENUECAT_WEBHOOK_SECRET=replace-with-at-least-32-random-bytes
REVENUECAT_WEBHOOK_SIGNING_SECRET=replace-with-dashboard-hmac-signing-secret
APPLE_BUNDLE_ID=com.avinashamanchi.resumeai
APPLE_TEAM_ID=REPLACE1234
APPLE_JWKS_URL=https://appleid.apple.com/auth/keys
